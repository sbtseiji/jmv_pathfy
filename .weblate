version: 1

project:
  name: pathfy
  website: https://github.com/sbtseiji/jmv_pathfy
  instructions: >
    Translate the UI strings for the pathfy jamovi module (Graphical SEM).
    Technical terms like "lavaan", "CFA", "SEM", "RMSEA", "CFI", "MLR", "FIML"
    should NOT be translated — keep them as-is.
    Operator symbols like "=~", "~~", "~" should be preserved.

components:
  - name: jamovi Module
    slug: pathfy
    vcs: git
    repo: https://github.com/sbtseiji/jmv_pathfy
    branch: main
    filemask: jamovi/i18n/*.po
    template: jamovi/i18n/en.po
    file_format: po
    license: GPL-2.0-or-later
    new_base: jamovi/i18n/en.po
    manage_units: true
    push_on_commit: false
    allow_translation_propagation: true
    check_flags: ignore-inconsistent
